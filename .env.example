# Copie ce fichier en .env, puis renseigne ta clé. Ne versionne jamais .env.

# litellm : passerelle de l’entreprise ; simule : service simulé, sans réseau ni quota.
SERVICE=litellm

LITELLM_BASE_URL=https://litellm.dverge.zone/v1
LITELLM_API_KEY=

# Modèles disponibles : gpt-luna, gpt-sol, claude-sonnet.
MODELE=gpt-luna
